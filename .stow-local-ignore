# Comments and blank lines are allowed.

# Default stow ignores - we must include these since .stow-local-ignore overrides defaults
RCS
.+,v
CVS
\.\#.+       # CVS conflict files / emacs lock files
\.cvsignore
\.svn
_darcs
\.hg
\.git
\.gitignore
\.gitmodules
.+~          # emacs backup files
\#.*\#       # emacs autosave files
^/README.*
^/LICENSE.*
^/COPYING

# Additional ignores for this repository

# Root-level installation scripts only
^/install\.sh$
^/uninstall\.sh$
^/update\.sh$
^/setup\.sh$
^/manual-install-helper\.sh$
diagnose

# Documentation (already covered by defaults for README/LICENSE)
^/CONTRIBUTING\.md

# Package build directories (match from root)
^/arch-packages
^/scriptdata
^/fedora
^/Extras
^/licenses

# Python cache files only (not all .py files)
.*\.pyc$
__pycache__
^/requirements\.txt
^/requirements\.in

# macOS files
\.DS_Store